# Copy to .env.local for local development. Set the same variables in Vercel
# (Project → Settings → Environment Variables) for production.

# ── Browser (public) ─────────────────────────────────────────────
# Supabase → Project Settings → API Keys. The publishable (anon) key is safe to expose: RLS protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Server only (never prefix these with VITE_) ─────────────────
# Supabase → Project Settings → API Keys → secret (service_role). Bypasses RLS: keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
# Google AI Studio → Get API key. Powers AI tutor tests and AI tutor matching.
GEMINI_API_KEY=
# Optional. Default: gemini-flash-latest, falling back to gemini-flash-lite-latest.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Any long random string. Vercel sends it to the daily demo-reset cron.
CRON_SECRET=

# ── Seed script only (npm run seed) ─────────────────────────────
# Creates or promotes this account to admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Migrations only (npm run db:migrate) ───────────────────────
# Supabase → Connect → Session pooler connection string.
DATABASE_URL=
